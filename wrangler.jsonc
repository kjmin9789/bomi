{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bomi",
  "main": "cloud/worker.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "preview_urls": false,
  "assets": { "directory": "./app", "binding": "ASSETS", "run_worker_first": true },
  "d1_databases": [{ "binding": "DB", "database_name": "bomi", "database_id": "00000000-0000-0000-0000-000000000000" }],
  "triggers": { "crons": ["*/5 * * * *"] },
  "observability": { "enabled": false }
}
